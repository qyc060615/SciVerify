VITE_LOCAL_DEMO_MODE=false
# Set true in .env.local for npm run dev without Supabase.
# Production builds always disable Local Demo, even if this flag is true.
# In Local Demo these two Supabase values may be empty.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

VITE_API_BASE_URL=http://127.0.0.1:8000
