BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://127.0.0.1:5173
RESEARCHGUARD_LOG_LEVEL=INFO

# Citation resolver (Milestone 2)
CROSSREF_API_URL=https://api.crossref.org
OPENALEX_API_URL=https://api.openalex.org
CITATION_USER_AGENT=SciVerify/0.1.0 (https://github.com/sciverify; citation-resolver)

# Paper retrieval (Milestone 3)
PAPER_REQUEST_TIMEOUT=30
MAX_DOCUMENT_SIZE=20971520
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Evidence retrieval (Milestone 4)
EVIDENCE_TOP_K=5
EVIDENCE_MIN_RELEVANCE=0.05
EVIDENCE_DIVERSITY_THRESHOLD=0.75
EVIDENCE_MAX_PER_SECTION=2

# Multi-agent verification (Milestone 5)
# DeepSeek verification/summary; model credentials stay in this backend file.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_REQUEST_TIMEOUT=60

# Future milestones (placeholders only — do not commit real values)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# CROSSREF_API_URL=https://api.crossref.org
# OPENALEX_API_URL=https://api.openalex.org
# LLM_API_KEY=
# LLM_MODEL=

# ResearchGuard M1: default keeps the lexical baseline.
RESEARCHGUARD_EVIDENCE_ENGINE=lexical
RESEARCHGUARD_EVIDENCE_TOP_K=5
# Local Demo E2E: change RESEARCHGUARD_EVIDENCE_ENGINE above to paperqa2.
# Provider-qualified identifiers; LLM uses DeepSeek, embedding uses Alibaba Beijing.
PAPERQA2_MODEL=openai/deepseek-flash
PAPERQA2_EMBEDDING_MODEL=openai/text-embedding-v4
PAPERQA2_EVIDENCE_CANDIDATES=10
PAPERQA2_MAX_CONCURRENT_REQUESTS=4
PAPERQA2_REQUEST_TIMEOUT=60
# python-dotenv expands the DeepSeek key already filled in above.
PAPERQA2_API_KEY=${LLM_API_KEY}
PAPERQA2_API_BASE=https://api.deepseek.com/v1
# A separate Alibaba Model Studio key (Beijing / mainland China).
PAPERQA2_EMBEDDING_API_KEY=
PAPERQA2_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Use LiteLLM bundled cost/dimension metadata; avoid an unrelated metadata refresh.
LITELLM_LOCAL_MODEL_COST_MAP=True

# M2 local cache (blank uses backend/data/researchguard/sources)
RESEARCHGUARD_SOURCE_CACHE_DIR=
RESEARCHGUARD_SOURCE_MAX_SIZE=20971520
# Bounded process-local PaperQA source indexes; 0 disables reuse
RESEARCHGUARD_PAPERQA_CACHE_SIZE=8
